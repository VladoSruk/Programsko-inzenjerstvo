' ==============================================================================
' 4-1-crisismap-system-CMP.puml
'
' Svrha:    Prikazuje glavne komponente sustava CrisisMap, njihove ovisnosti i
'           vanjske sustave s kojima komuniciraju (kartografske pločice, FCM).
'           Klase, metode i fizička mrežna topologija namjerno nisu
'           obuhvaćeni (vidi dijagrame 4-3 i 6-1).
' Autor:    Vlado Sruk, kolegij Programsko inženjerstvo
' AI:       Dijagram je izradio autor. AI je pomogao u reviziji i komentarima;
'           autor ih je pregledao i odgovara za konačni sadržaj.
' Praćenje: Komponente treba uskladiti sa strukturom repozitorija i
'           implementiranim uslugama; pri promjeni arhitekture ažurirati model.
'
' Diagram level: High-level logical architecture
' Diagram type:  UML Component Diagram
' Version:       1.3
' ==============================================================================

@startuml
title Sustav CrisisMap – komponente
left to right direction

skinparam shadowing false
skinparam defaultFontName Arial
skinparam componentStyle rectangle
skinparam ArrowColor #212529

skinparam component {
    BackgroundColor #E7F1FF
    BorderColor #0D6EFD
}

skinparam database {
    BackgroundColor #FFF3CD
    BorderColor #212529
}

' ==============================================================================
' Granica sustava i unutarnje komponente
' ==============================================================================

rectangle "Sustav CrisisMap" {
  component "Web-klijent" as Web
  rectangle "Poslužiteljska aplikacija" {
    component "API za prijave" as API
    component "Usluga za prijave" as Reports
    component "Proces za obavijesti" as Notify
  }
  database "PostgreSQL" as DB
}

' ==============================================================================
' Vanjski sustavi
' ==============================================================================

component "Pružatelj kartografskih pločica\n(vanjski)" as Maps
component "Firebase Cloud Messaging\n(vanjski)" as FCM

' ==============================================================================
' Ovisnosti i sučelja
' ==============================================================================

Web --> API : zahtjevi i odgovori za prijave
Web --> Maps : kartografske pločice
API --> Reports : podnošenje i dohvat prijava
Reports --> DB : pohrana i dohvat prijava
Notify --> DB : odabir potvrđenih prijava\ni primatelja
Notify --> FCM : zahtjevi za slanje obavijesti
@enduml
